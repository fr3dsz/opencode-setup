{
  "$schema": "https://opencode.ai/config.json",
  // Portable OpenCode 2.x configuration template.
  //
  // Never copied verbatim: the installer renders the @@...@@ placeholders to
  // absolute paths in the pinned Node tree, strips full-line // comments,
  // and refuses to deploy if any placeholder survives.
  // - @@NODE@@          pinned Node executable (exact version check)
  // - @@GITNEXUS_CLI@@  GitNexus dist/cli/index.js in that Node tree
  // - @@DEVTOOLS_CLI@@  chrome-devtools-mcp bin in that Node tree
  //
  // Permissions are guardrails for free models: later rules override
  // earlier ones, and agent defaults are applied first.
  "permissions": [
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },
    { "action": "shell", "resource": "*git push*", "effect": "ask" },
    { "action": "shell", "resource": "*git commit*", "effect": "ask" },
    { "action": "shell", "resource": "*git rebase*", "effect": "ask" },
    { "action": "shell", "resource": "*git branch -D*", "effect": "ask" },
    { "action": "shell", "resource": "*git push --force*", "effect": "deny" },
    { "action": "shell", "resource": "*git push -f*", "effect": "deny" },
    { "action": "shell", "resource": "*git reset --hard*", "effect": "deny" },
    { "action": "shell", "resource": "*git clean -*", "effect": "deny" },
    { "action": "shell", "resource": "*git checkout -- *", "effect": "deny" },
    { "action": "shell", "resource": "*rm -rf*", "effect": "ask" },
    { "action": "shell", "resource": "*rm -r *", "effect": "ask" },
    { "action": "shell", "resource": "*sudo *", "effect": "deny" },
    { "action": "shell", "resource": "*npm install*", "effect": "ask" },
    { "action": "shell", "resource": "*npm i *", "effect": "ask" },
    { "action": "shell", "resource": "*pnpm add*", "effect": "ask" },
    { "action": "shell", "resource": "*yarn add*", "effect": "ask" },
    { "action": "shell", "resource": "*pip install*", "effect": "ask" },
    { "action": "shell", "resource": "*curl *", "effect": "ask" },
    { "action": "shell", "resource": "*wget *", "effect": "ask" }
  ],
  // Bounded loops: free models can repeat a failing step indefinitely.
  "agents": {
    "build": {
      "steps": 100,
      "permissions": [
        { "action": "edit", "resource": "*.env.example", "effect": "allow" }
      ]
    },
    "plan": { "steps": 50 }
  },
  "mcp": {
    "servers": {
      "gitnexus": {
        "type": "local",
        "command": ["@@NODE@@", "@@GITNEXUS_CLI@@", "mcp"]
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "@@NODE@@",
          "@@DEVTOOLS_CLI@@",
          "--isolated",
          "--no-usage-statistics",
          "--redact-network-headers",
          "--category-memory=false",
          "--category-emulation=false"
        ]
      }
    }
  }
}
